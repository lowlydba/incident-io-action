{
  "name": "incident-io-action",
  "description": "Unofficial GitHub Action to send alerts to incident.io",
  "version": "0.0.0",
  "author": "lowlydba",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/lowlydba/incident-io-action",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lowlydba/incident-io-action.git"
  },
  "bugs": {
    "url": "https://github.com/lowlydba/incident-io-action/issues"
  },
  "keywords": [
    "actions",
    "incident",
    "alert",
    "incident.io",
    "monitoring",
    "observability"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "node --test '__tests__/**/*.test.ts'",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "local-action": "npx @github/local-action . src/main.ts .env",
    "package": "npx rollup --config rollup.config.ts --configPlugin rollup-plugin-esbuild",
    "package:watch": "npm run package -- --watch",
    "test": "node --test '__tests__/**/*.test.ts'",
    "typecheck": "npx tsc --noEmit -p tsconfig.json",
    "all": "npm run format:write && npm run lint && npm run typecheck && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@github/local-action": "^7.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "prettier-eslint": "^16.4.2",
    "rollup": "^4.63.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@~6.0.2"
  },
  "overrides": {
    "@typescript-eslint/eslint-plugin": {
      "typescript": "npm:@typescript/typescript6@~6.0.2"
    },
    "@typescript-eslint/parser": {
      "typescript": "npm:@typescript/typescript6@~6.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "typescript": "npm:@typescript/typescript6@~6.0.2"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  }
}
